# Required: JWT secret for token signing
AUTH_JWT_SECRET=change-me-to-a-random-secret

# Email delivery mode: "smtp" (default) or "log" (print login codes to stdout)
EMAIL_MODE=log

# SMTP settings (required when EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional: load settings from a YAML file (default: backend/config.yaml when running in backend/)
# CONFIG_FILE=./backend/config.yaml

# Optional: Base currency for reports and budgets (default: EUR)
FX_BASE_CURRENCY=EUR
